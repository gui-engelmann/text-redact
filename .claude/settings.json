{
  "permissions": {
    "ask": ["Bash(git commit*)", "Bash(git push*)"]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npm run lint --silent",
            "timeout": 60,
            "statusMessage": "Running ESLint..."
          }
        ]
      }
    ]
  }
}
